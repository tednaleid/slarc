{# ABOUTME: A thread under its parent message: reply count, participant avatars and last reply #}
{# ABOUTME: time, with the replies inline on a thread page or as a link to the thread's panel. #}
{% set summary %}
<span class="participants">
{% for p in thread.participants %}
{% if p.picture %}
{{ p.picture.html("participant-img", p.name) }}
{% else %}
<span class="participant">{{ p.name }}</span>
{% endif %}
{% endfor %}
</span>
<span class="reply-count">{{ thread.replies|length }} {{ "reply" if thread.replies|length == 1 else "replies" }}</span>
{% if thread.latest %}
<span class="latest">Last reply <time datetime="{{ thread.latest.iso }}" data-format="full">{{ thread.latest.full }}</time></span>
{% endif %}
{% endset %}
{% if thread.inline %}
<div class="thread">
<div class="thread-summary">
{{ summary }}
</div>
<div class="replies">
{% for m in thread.replies %}
{% include "_message.html.j2" %}
{% endfor %}
</div>
</div>
{% else %}
<a class="thread-summary" href="#{{ thread.anchor }}">
{{ summary }}
</a>
{% endif %}
